<odoo>
  <data>
    <record id="report_ryb_invoice_homestaging" model="ir.actions.report">
        <field name="name">Factura Home Staging</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ryb_invoice_homestaging.factura_homestaging_template</field>
        <field name="print_report_name">((object.name or 'borrador').replace('/',''))</field>
        <field name="attachment_use" eval="False"/>
        <field name="attachment">(object.state in ('open','paid','posted')) and ((object.name or '').replace('/','')+'.pdf')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>




    <template id="factura_homestaging_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ryb_invoice_homestaging.esquema_factura_document"/>
            </t>
        </t>
    </template>




    <template id="aux_para_datos">
        <t t-name="ryb_invoice_homestaging.aux_para_datos">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <t t-call="ryb_invoice_homestaging.encabezadoypie"><t t-raw="0"/></t>
        </t>
    </template>




    <template id="encabezadoypie">

        <t t-name="ryb_invoice_homestaging.encabezadoypie">

            <div class="header">
                <div class="row">

                    <!-- Logo empresa -->
                    <div class="col-6" style="margin-top:35px;">
                        <img src="/ryb_invoice_homestaging/static/src/img/logo_homestaging.jpg"/>
                    </div>

                    <!-- Direccion empresa -->
                    <div class="col-6 text-end" style="margin-top:35px;text-align:right;">
                        <p class="font-weight-bold mb-0 mt-3"><b>RENT &amp; BUY, S.A.</b></p>
                        <p class="font-weight-normal mb-3">CIF: A80946312</p>
                        <p class="font-weight-normal mb-0">C/ López de Aranda 22 (local)</p>
                        <p class="font-weight-normal mb-0">28027 Madrid - España</p>
                        <p class="font-weight-normal mb-0">Tel: +34 91 320 32 25</p>
                    </div>

                </div>
                <div class="row mt-2">
                    <div class="col-8"><hr/></div>
                    <div class="col-2 text-center align-top">
                        <h5 style="font-weight: bold; font-style: italic">Factura</h5>
                    </div>
                    <div class="col-2"><hr/></div>
                </div>

            </div>

            <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-call="web.address_layout"/>
                <t t-raw="0"/>
            </div>


            <!-- Footer de la factura  -->
            <div class="footer o_standard_footer">
                <div class="text-center" style="border-top: 1px solid Black; padding-top:15px">
                    <ul class="list-unstyled">
                        <li><b><span style="font-style: italic;">Muchas gracias por confiar en nosotros</span></b></li>
                        <li><span>www.ryb.es - ryb@ryb.es</span></li>
                    </ul>
                </div>
            </div>

        </t>

    </template>



    <!-- Contenido de la factura -->
    <template id="esquema_factura_document">

        <t t-call="ryb_invoice_homestaging.aux_para_datos">


            <div class="page">

                <t t-set="o" t-value="o.with_context(lang=lang)"/>

                <!-- Datos del cliente -->
                <div class="row">
                    <div class="col-12" style="margin-top:100px; margin-bottom:60px;"> 
                        <p style="font-weight: bold; margin-bottom: -15px; "><span t-field="o.partner_id.name"/></p>
                        <p class="mt-0"><span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/></p>
                        <p class="mt16">NIF/CIF: <span t-field="o.partner_id.vat"/></p>
                    </div>
                </div>

                <!-- Datos de la factura -->
                <div class="row">
                    <div class="col-2">
                        <p><span t-if="o.move_type == 'out_invoice' and o.state in ('open', 'in_payment', 'paid', 'draft', 'posted')">Factura</span></p>
                    </div>
                    <div class="col-10">
                        <p style="font-weight:bold;"><span t-field="o.name"/></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-2">
                        <p><span t-if="o.invoice_date" name="invoice_date">Fecha</span></p>
                    </div>
                    <div class="col-10">
                        <p style="font-weight: bold;"><span class="m-0" t-field="o.invoice_date"/></p>
                    </div>
                </div>


                <!-- Detalle conceptos factura -->
                <table class="table table-sm o_main_table mt-4" name="invoice_line_table">

                    <thead style="background-color:Black; color:white;">
                        <tr>
                            <th class="text-left" style="width:80%"><span>Descripción</span></th>

                            <th class="text-end" style="width:20%"><span >Importe</span></th>
<!--                             <t t-set="colspan" t-value="9"/>
                            <th class="text-left"><span>Descripción</span></th>

                            <t t-set="colspan" t-value="3"/>
                            <th class="text-end"><span >Importe</span></th>
 -->                        </tr>
                    </thead>

                    <tbody class="invoice_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="o.invoice_line_ids" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" />
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'"  name="account_invoice_line_accountable">
                                    <td name="account_invoice_line_name"><span t-field="line.name"/></td>
                                    <td class="text-end o_price_total"><span t-field="line.price_subtotal" /></td>
                                </t>

                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99"><span t-field="line.name"/></td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>

                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99"><span t-field="line.name"/></td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or o.invoice_line_ids[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>

                        </t>

                    </tbody>
                </table>


                <!-- Apartado subtotales de factura -->
                <div id="right-elements" t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-5 d-inline-block float-end">
                                <div id="total" class="clearfix row">
                                    <div class="ms-auto">
                                        <table class="table table-sm table-borderless avoid-page-break-inside">

                                            <!--Tax totals-->
                                            <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                            <t t-call="account.document_tax_totals"/>

                                            <!--Payments-->
                                            <t t-if="print_with_payments">
                                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                                            <td>
                                                                <i class="oe_form_field text-end oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}">2021-09-19</t></i>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-out="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}">20.00</span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="len(payments_vals) &gt; 0">
                                                        <tr class="border-black fw-bold">
                                                            <td>Amount Due</td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_residual">11.05</span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </table>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                                        Total amount in words: <br/>
                                        <small class="text-muted lh-sm"><span t-field="o.amount_total_words">Thirty one dollar and Five cents</span></small>
                                    </p>
                                </div>
                                <t t-call="account.document_tax_totals_company_currency_template"/>
                            </div>

                <div style="height: 60px">
                </div>

                <!-- Forma de pago     -->
                <div class="row">
                    <div class="col-12">
                        <p class="mb-0" style="font-weight:bold;">Términos y condiciones</p>
                        <p class="mb-0" style="font-weight:light; font-size:12px">Pago por transferencia a:</p>
                        <p class="mb-0" style="font-weight:bold; font-size:12px">Titular: RENT &amp; BUY S.A.</p>
                        <p class="mb-0" style="font-weight:light; font-size:12px">CaixaBank</p>
                        <p class="mb-0" style="font-weight:light; font-size:12px">C/ Tampico c/v Tumaco, 10</p>
                        <p class="mb-0" style="font-weight:light; font-size:12px">28027 Madrid</p>
                        <p class="mb-0" style="font-weight:light; font-size:12px">SWIFT (BIC): CAIX ES BB XXX</p>

                        <p class="mb-0" style="font-weight:bold; font-size:14px">IBAN: ES49 2100 1189 0113 0020 9579</p>
                        
                    </div>
                </div>


            </div>

        </t>

    </template>


  </data>
</odoo>



